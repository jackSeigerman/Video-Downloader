  "bugs": {
    "url": "https://github.com/jackSeigerman/Video-Downloader/issues"
  },
  "homepage": "https://github.com/jackSeigerman/Video-Downloader#readme",
  "devDependencies": {
    "electron": "^37.3.0"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "electron": "^37.3.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "path": "^0.12.7"
  }
