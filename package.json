{
  "name": "video-downloader",
  "version": "1.0.0",
  "description": "A modern Electron desktop application for downloading YouTube videos in high quality using yt-dlp. Supports MP4 video downloads and MP3 audio extraction with custom directory selection.",
  "copyright": "Copyright © 2025 Jack Seigerman",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackSeigerman/Video-Downloader.git"
  },
  "author": "Jack Seigerman",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jackSeigerman/Video-Downloader/issues"
  },
  "homepage": "https://github.com/jackSeigerman/Video-Downloader#readme",
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "node-id3": "^0.2.9",
    "path": "^0.12.7",
    "sharp": "^0.34.3",
    "yt-dlp-wrap": "^2.3.12"
  },
  "build": {
    "appId": "com.jackseigerman.videodownloader",
    "productName": "Video Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test/**/*",
      "!debug*.js",
      "!check*.js",
      "!main-ytdl-core-backup.js",
      "!main-ytdlp.js",
      "!ffmpeg.zip",
      "!ffmpeg-7.1.1-essentials_build/**/*",
      "node_modules/**/*",
      "yt-dlp.exe",
      "ffmpeg.exe"
    ],
    "extraResources": [
      {
        "from": "yt-dlp.exe",
        "to": "yt-dlp.exe"
      },
      {
        "from": "ffmpeg.exe", 
        "to": "ffmpeg.exe"
      },
      {
        "from": "node_modules/yt-dlp-wrap/bin",
        "to": "yt-dlp-wrap/bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/yt-dlp-wrap/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/YoutubeDownloaderLogo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
